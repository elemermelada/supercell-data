# Request

BROWSER_TYPE=firefox

# RETRIEVE

IMAP_SERVER=imap.gmail.com
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=yourpassword
SENDER_FILTER=no-reply@mydata.supercell.com

# UPDATE
SPREADSHEET_ID="your-id"
SHEET_NAME="HayDayData"

# MONITORING (failure alert email)
# Reuses EMAIL_USER / EMAIL_PASS above to authenticate.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
# Where failure alerts are delivered; defaults to EMAIL_USER if unset.
ALERT_EMAIL=youraddress@gmail.com